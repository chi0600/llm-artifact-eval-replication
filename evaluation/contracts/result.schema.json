{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/result.schema.json",
  "title": "Artifact Evaluation Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "artifact_id",
    "verdict",
    "gates",
    "scores",
    "overall_score",
    "diagnostics"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "artifact_id": {
      "type": "string",
      "minLength": 1
    },
    "verdict": {
      "type": "string",
      "enum": ["pass", "fail", "needs_review"]
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "stage", "oracle_type", "blocking", "passed"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "stage": {
            "type": "string",
            "enum": [
              "validity",
              "normalization",
              "consistency",
              "fidelity",
              "execution",
              "quality"
            ]
          },
          "oracle_type": {
            "type": "string",
            "enum": ["schema", "rule", "test", "llm_judge", "human_review"]
          },
          "blocking": {
            "type": "boolean"
          },
          "passed": {
            "type": "boolean"
          },
          "evidence": {
            "type": "string"
          }
        }
      }
    },
    "scores": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "number"
      }
    },
    "overall_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "diagnostics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pipeline_stage", "notes"],
      "properties": {
        "pipeline_stage": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": "string"
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
